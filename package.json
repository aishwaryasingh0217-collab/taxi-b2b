{
  "name": "taxi-b2b-root",
  "version": "1.0.0",
  "private": true,
  "description": "Taxi B2B Fleet & Driver Operations Platform Root",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "client": "npm --prefix frontend run dev",
    "server": "cd backend && .venv/bin/python manage.py runserver 8000"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
